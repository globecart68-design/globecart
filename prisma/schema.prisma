generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────
enum SocialProvider {
  google
  facebook
  apple
}

enum FriendStatus {
  pending
  accepted
  rejected
}

enum PostType {
  image
  video
  text
  reel
}

enum MusicSource {
  library
  original
}

enum MusicStatus {
  processing
  ready
  blocked
}

enum MessageType {
  text
  image
  video
  audio
  file
}

enum BusinessType {
  grocery_food
  restaurants_cafes
  fashion
  electronics
  home_and_living
  automotive
  books_and_education
  pets
  sports_and_outdoor
  health_and_beauty
  other
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  assigned
  in_transit
  delivered
  cancelled
  refunded
}

enum RideStatus {
  requested
  accepted
  in_progress
  completed
  cancelled
}

enum AssignedOrderStatus {
  assigned
  picked_up
  in_transit
  delivered
  failed
}

/// Drop-off instruction the customer leaves for the Address-mode delivery
/// sheet — mirrors the Ring Bell / Call Me / Leave at Door chips in the
/// Flutter Map Hub.
enum DropoffPreference {
  ring_bell
  call_me
  leave_at_door
}

/// Order tracking timeline steps shown in Track mode — one enum value per
/// step in the Flutter TrackingTimeline widget.
enum TrackingStatus {
  order_confirmed
  preparing
  picked_up
  on_the_way
  delivered
}

enum ReportTargetType {
  user
  post
  comment
  business
  message
}

enum ReportReason {
  spam
  harassment
  hate_speech
  nudity
  violence
  false_information
  scam
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id             String         @id @default(uuid())
  email          String?        @unique
  phone          String?        @unique
  passwordHash   String? // Set only for accounts using password auth; null for OTP/social-only accounts
  createdAt      DateTime       @default(now())
  // Auth & Role Management
  providers      AuthProvider[]
  sessions       Session[]
  roles          UserRole[]
  lastActiveRole String? // Remembers the user's last selected role across sessions
  // Profile
  profile        UserProfile?
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  // Social graph
  following      Follow[]       @relation("follower")
  followers      Follow[]       @relation("following")
  friends        Friend[]       @relation("Friends1")
  friendOf       Friend[]       @relation("Friends2")
  streaks        Streak[]       @relation("Streaks1")
  streakOf       Streak[]       @relation("Streaks2")

  // Content
  posts        Post[]
  stories      Story[]
  uploadedMusic Music[]
  favoriteMusic MusicFavorite[]
  storyViews   StoryView[]
  postLikes    PostLike[]
  postComments PostComment[]
  savedPosts   SavedPost[]
  shares       Share[]

  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  // Commerce
  businesses       Business[]       @relation("UserBusinesses")
  orders           Order[]
  reviews          Review[]
  favoriteShops    FavoriteShop[]
  // Logistics
  driverProfile    DriverProfile?
  deliveryProfile  DeliveryProfile?
  ridesAsCustomer  Ride[]
  addresses        Address[]
  // Moderation
  blocksGiven      Block[]          @relation("BlocksGiven")
  blocksReceived   Block[]          @relation("BlocksReceived")
  reportsFiled     Report[]         @relation("ReportsFiled")
  repost         Repost[]

  @@index([email])
  @@index([phone])
}

model UserProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  username           String    @unique
  handle             String    @unique
  bio                String?
  profilePhoto       String?
  createdAt          DateTime  @default(now())
  lastHandleChange   DateTime?
  lastUsernameChange DateTime?
  lastAvatarChange   DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([handle])
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuthProvider {
  id             String         @id @default(uuid())
  provider       SocialProvider
  providerUserId String
  displayName    String?
  avatarUrl      String?
  createdAt      DateTime       @default(now())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([provider, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sessions
// ─────────────────────────────────────────────────────────────────────────────
model Session {
  id        String   @id @default(uuid())
  userId    String?
  role      String?
  deviceId  String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP Codes
// ─────────────────────────────────────────────────────────────────────────────
model OTPCode {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  code      String
  purpose   String   @default("auth") // 'auth' | 'password_reset' — see OtpPurpose in auth.service.ts
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose, expiresAt])
  @@index([email, purpose, expiresAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social Graph
// ─────────────────────────────────────────────────────────────────────────────
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Friend {
  id        String       @id @default(uuid())
  userId    String
  friendId  String
  status    FriendStatus @default(pending)
  createdAt DateTime     @default(now())
  user      User         @relation("Friends1", fields: [userId], references: [id], onDelete: Cascade)
  friend    User         @relation("Friends2", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
}

model Streak {
  id                String   @id @default(uuid())
  userId            String
  friendId          String
  count             Int      @default(0)
  lastInteractionAt DateTime
  userLastAt        DateTime // new — my last interaction timestamp
  friendLastAt      DateTime // new — their last interaction timestamp
  user              User     @relation("Streaks1", fields: [userId], references: [id], onDelete: Cascade)
  friend            User     @relation("Streaks2", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social Content
// ─────────────────────────────────────────────────────────────────────────────
model Post {
  id           String   @id @default(uuid())
  userId       String
  type         PostType
  contentUrl   String?
  mediaType    String
  thumbnailUrl String?
  caption      String?  @db.VarChar(2200)
  audience     String   @default("everyone")
  locationTag  String?

  //counts
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0) // ← Added
  savedCount    Int @default(0) // ← Added
  repostCount Int @default(0)

  // Music (sound attached to this post, TikTok/Reels-style)
  musicId       String?
  musicStart    Int?     @default(0)   // seconds into the track where playback starts
  musicDuration Int?                    // seconds of the track actually used
  musicVolume   Float?   @default(1.0) // 0.0 - 1.0, mix level against original clip audio
  music         Music?   @relation(fields: [musicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes        PostLike[]
  comments     PostComment[]
  savedPosts   SavedPost[]
  shares       Share[]
  repost     Repost[] // ← New
  repostFrom Repost[]     @relation("RepostOriginal")

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([musicId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Story {
  id              String   @id @default(uuid())
  userId          String
  contentUrl      String?
  textContent     String?
  backgroundColor String?
  mediaType       String   @default("image")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Music (sound attached to this story)
  musicId       String?
  musicStart    Int?     @default(0)
  musicDuration Int?
  musicVolume   Float?   @default(1.0)
  music         Music?   @relation(fields: [musicId], references: [id], onDelete: SetNull)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([userId, expiresAt])
  @@index([musicId])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model Music {
  id           String       @id @default(uuid())
  title        String
  artist       String
  album        String?
  artworkUrl   String?

  audioUrl     String
  duration     Int

  source       MusicSource  @default(library)
  status       MusicStatus  @default(ready)

  uploadedById String?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  playCount    Int @default(0)
  useCount     Int @default(0)
  favoriteCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts          Post[]
  stories        Story[]
  businessPosts  BusinessPost[]
  businessStories BusinessStory[]
  favorites      MusicFavorite[]

  @@index([title])
  @@index([artist])
  @@index([uploadedById])
  @@index([createdAt(sort: Desc)])
  @@index([source])
  @@index([status])
}

/// A user "favoriting" (saving) a sound to their own sound library.
/// Backs POST /music/:id/favorite and DELETE /music/:id/favorite, and keeps
/// Music.favoriteCount as a fast denormalized counter in sync.
model MusicFavorite {
  id        String   @id @default(uuid())
  userId    String
  musicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  music Music @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([userId, musicId])
  @@index([userId])
  @@index([musicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Share & SavedPost — Properly Related
// ─────────────────────────────────────────────────────────────────────────────
model Share {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Repost {
  id             String   @id @default(uuid())
  userId         String
  originalPostId String
  caption        String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPost Post    @relation("RepostOriginal", fields: [originalPostId], references: [id], onDelete: Cascade)
  post         Post?   @relation(fields: [postId], references: [id])
  postId       String?

  @@unique([userId, originalPostId])
  @@index([userId])
  @@index([originalPostId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Messages
// ─────────────────────────────────────────────────────────────────────────────
model Message {
  id         String      @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  type       MessageType
  createdAt  DateTime    @default(now())
  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Businesses & Products
// ─────────────────────────────────────────────────────────────────────────────
model Business {
  id             String           @id @default(uuid())
  ownerId        String
  name           String
  businessType   BusinessType
  description    String?
  location       String?
  profilePhoto   String?
  logoPhoto      String?
  bannerPhoto    String?
  createdAt      DateTime         @default(now())
  parentId       String?
  parent         Business?        @relation("BusinessHierarchy", fields: [parentId], references: [id])
  children       Business[]       @relation("BusinessHierarchy")
  owner          User             @relation("UserBusinesses", fields: [ownerId], references: [id], onDelete: Cascade)
  products       Product[]
  inventory      Inventory[]
  orders         Order[]
  reviews        Review[]
  favoriteShops  FavoriteShop[]
  posts          BusinessPost[]
  stories        BusinessStory[]
  operatingHours OperatingHours[]
  isActive       Boolean          @default(false)
  minOrderAmount Float?

  @@index([ownerId])
  @@index([businessType])
  @@index([name])
  @@index([parentId])
}

model OperatingHours {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int // 0 = Monday, 1 = Tuesday, ..., 6 = Sunday
  isOpen     Boolean  @default(true)
  openTime   String? // Format: "HH:MM" (24-hour)
  closeTime  String? // Format: "HH:MM" (24-hour)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Product {
  id             String           @id @default(uuid())
  businessId     String
  name           String
  category       String
  price          Float
  comparePrice   Float?
  stock          Int              @default(0)
  description    String?
  sku            String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  trackInventory Boolean          @default(true)
  taxable        Boolean          @default(true)
  taxClass       String?
  weight         Float?
  length         Float?
  width          Float?
  height         Float?
  shippingClass  String?
  attributes     Json?
  createdAt      DateTime         @default(now())
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  inventory      Inventory?
  variants       ProductVariant[]
  images         ProductImage[]

  @@index([businessId])
  @@index([category])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  name       String
  sku        String?
  priceDelta Float    @default(0)
  stock      Int      @default(0)
  attributes Json?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String   @unique
  businessId      String
  currentStock    Int      @default(0)
  minStock        Int      @default(0)
  maxStock        Int      @default(1000)
  lastRestockedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
}

model BusinessPost {
  id         String   @id @default(uuid())
  businessId String
  type       PostType
  contentUrl String?
  caption    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Music (sound attached to this business post)
  musicId       String?
  musicStart    Int?     @default(0)
  musicDuration Int?
  musicVolume   Float?   @default(1.0)
  music         Music?   @relation(fields: [musicId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([musicId])
}

model BusinessStory {
  id         String   @id @default(uuid())
  businessId String
  contentUrl String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Music (sound attached to this business story)
  musicId       String?
  musicStart    Int?     @default(0)
  musicDuration Int?
  musicVolume   Float?   @default(1.0)
  music         Music?   @relation(fields: [musicId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([expiresAt])
  @@index([musicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────
model Order {
  id         String          @id @default(uuid())
  customerId String
  businessId String
  total      Float
  status     OrderStatus     @default(pending)
  createdAt  DateTime        @default(now())
  customer   User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  assignedTo AssignedOrder[]
  tracking   OrderTracking?

  @@index([customerId])
  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  /// Integer 1–5. Enforced at the application layer; Prisma has no range constraint.
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

model FavoriteShop {
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Business @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Driver & Delivery
// ─────────────────────────────────────────────────────────────────────────────
model DriverProfile {
  id            String           @id @default(uuid())
  userId        String           @unique
  vehicleType   String
  licenseNumber String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rides         Ride[]
  locations     DriverLocation[]
}

model Ride {
  id             String        @id @default(uuid())
  // Nullable: a ride is created in `requested` status before a driver has
  // been matched (POST /rides/request). driverId is set once matched.
  driverId       String?
  customerId     String
  pickupLocation String
  dropLocation   String
  // Coordinates alongside the human-readable labels above — the labels are
  // what's shown in the UI, the coordinates are what the map/gateway needs
  // for markers, routing, and ETA.
  pickupLat      Float
  pickupLng      Float
  dropLat        Float
  dropLng        Float
  vehicleType    String        @default("economy") // economy | comfort | xl | bike
  status         RideStatus    @default(requested)
  fare           Float
  distanceKm     Float?
  etaMinutes     Int?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  // SetNull (not Cascade) — losing a driver profile shouldn't delete ride
  // history, just orphan the reference.
  driver         DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([customerId])
  @@index([status])
  @@index([customerId, createdAt])
}

model DriverLocation {
  id        String        @id @default(uuid())
  driverId  String
  latitude  Float
  longitude Float
  updatedAt DateTime      @default(now())
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([driverId, updatedAt])
}

model DeliveryProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  vehicleType    String
  licenseNumber  String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedOrders AssignedOrder[]
  locations      DeliveryLocation[]
}

model AssignedOrder {
  id         String              @id @default(uuid())
  deliveryId String
  orderId    String
  status     AssignedOrderStatus @default(assigned)
  updatedAt  DateTime            @default(now())
  delivery   DeliveryProfile     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([orderId])
}

model DeliveryLocation {
  id         String          @id @default(uuid())
  deliveryId String
  latitude   Float
  longitude  Float
  updatedAt  DateTime        @default(now())
  delivery   DeliveryProfile @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Device Tokens
// ─────────────────────────────────────────────────────────────────────────────
model DeviceToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  platform    String
  endpointArn String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Moderation — Block & Report
// ─────────────────────────────────────────────────────────────────────────────
/// Global block between any two users, regardless of follow/friend status.
/// Blocking auto-removes follow and friend rows (handled in BlocksService).
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// Global report — targets user, post, comment, business, or message.
/// Duplicate open reports per reporter+target are prevented at the service layer.
model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reporter   User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Map Hub — Saved Addresses (Address mode)
// ─────────────────────────────────────────────────────────────────────────────
model Address {
  id                String            @id @default(uuid())
  userId            String
  nickname          String // "Home", "Work", "Other", or a custom label
  fullAddress       String
  latitude          Float
  longitude         Float
  building          String?
  floor             String?
  apartment         String?
  instructions      String?
  dropoffPreference DropoffPreference @default(ring_bell)
  isDefault         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

// ─────────────────────────────────────────────────────────────────────────────
// Map Hub — Order Tracking (Track mode)
// ─────────────────────────────────────────────────────────────────────────────

/// Live tracking snapshot for one Order — current status + the delivery
/// driver's last known position. One row per Order; history of status
/// changes lives in OrderTrackingEvent.
model OrderTracking {
  id         String               @id @default(uuid())
  orderId    String               @unique
  status     TrackingStatus       @default(order_confirmed)
  driverLat  Float?
  driverLng  Float?
  etaMinutes Int?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events     OrderTrackingEvent[]

  @@index([orderId])
}

/// Append-only status history for an OrderTracking row — backs the
/// "✓ Order Confirmed / ✓ Preparing / ● On the Way / ○ Delivered" timeline.
model OrderTrackingEvent {
  id         String         @id @default(uuid())
  trackingId String
  status     TrackingStatus
  note       String?
  createdAt  DateTime       @default(now())
  tracking   OrderTracking  @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@index([trackingId])
  @@index([createdAt])
}
